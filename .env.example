# Vorlage. Kopieren nach ".env" (im selben Ordner) und den Schlüssel eintragen.
# Die Datei .env wird nie eingecheckt (steht in .gitignore).

# API-Schlüssel aus https://platform.claude.com (Settings > API Keys)
ANTHROPIC_API_KEY=

# Optional: anderes Modell. Standard ist claude-opus-5-5.
# Günstiger wäre z. B. claude-sonnet-5-5 oder claude-haiku-5-5.
# BRIEFHELFER_MODELL=claude-opus-5-5

# Betriebsart: "voll" (Standard, eigene Briefe) oder "demo" (nur Beispielbriefe, keine KI-Aufrufe)
# PUBLIC_BRIEFHELFER_MODUS=voll

# Optional: Anfragen pro Tag und Adresse (Standard 5)
# BRIEFHELFER_LIMIT_PRO_TAG=5
