---
// Fußzeile mit Rechtsseiten und dem offenen Hinweis auf Galini Studio (in der Ecke unten rechts).
// Der Hinweis ist klar als Absender erkennbar, keine versteckte Werbung.
import { marke } from '../config';
---
<footer class="fuss">
  <nav aria-label="Rechtliches">
    <a href="/impressum">Impressum</a>
    <a href="/datenschutz">Datenschutz</a>
    <a href={marke.quellcode} target="_blank" rel="noopener">Quellcode auf GitHub</a>
  </nav>
  <p class="leise">Der Briefhelfer erklärt Briefe. Er ersetzt keine Rechtsberatung.</p>
</footer>

<a class="absender" href={marke.url} target="_blank" rel="noopener">
  <span class="absender-klein">Ein Werkzeug von</span>
  <span class="absender-name">{marke.name}</span>
</a>
